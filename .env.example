# MyWallet environment variables (example - copy to .env and fill in real values)
#
# DO NOT copy this file's values to production. They are placeholders only.
# The placeholder AUTH_SECRET below is INTENTIONALLY shorter than the
# 32-char minimum, so even if it leaks into production by mistake, the
# auth lib's eager validation at module load will reject it and crash
# the process before serving any request.
#
# P0.9: NODE_ENV is intentionally NOT set here. NODE_ENV is a runtime
# configuration that should be set by the deployment environment
# (e.g., `NODE_ENV=production` in your systemd service file, Docker
# Compose, or Vercel project settings). Hard-coding it in .env makes
# it easy to accidentally ship `NODE_ENV=development` to production,
# which would silence the AUTH_SECRET validation.

DATABASE_URL=file:./db/custom.db
AUTH_SECRET=REPLACE_ME
