// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===== User (المستخدم - تسجيل دخول) =====
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  budgets       Budget[]
  revokedTokens RevokedToken[]

  @@map("users")
}

// ===== RevokedToken (توكنات ملغاة - server-side logout) =====
// When a user logs out, the JWT is stored here until its natural expiry,
// so even a stolen copy cannot be used after the legitimate user logs out.
model RevokedToken {
  id        String   @id @default(cuid())
  token     String   @unique  // SHA-256 hash of the JWT (NOT the raw token - DB leak safe)
  userId    String
  expiresAt DateTime           // when the original token would have expired
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])   // for periodic cleanup
  @@index([userId])
  @@map("revoked_tokens")
}

// ===== Account (الحسابات) =====
model Account {
  id        String   @id @default(cuid())
  name      String
  type      AccountType
  currency  Currency
  balance   Float    @default(0)
  color     String   @default("#2563EB")
  icon      String   @default("wallet")
  isDefault Boolean  @default(false)
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  transfersTo   Transaction[] @relation("TransfersTo")

  @@map("accounts")
}

enum AccountType {
  CASH         // نقدي
  BANK         // بنك
  E_WALLET     // محفظة إلكترونية
  CARD         // بطاقة ائتمان
  SAVINGS      // حساب توفير
  INVESTMENT   // استثمار (ذهب، كريبتو، أسهم، صناديق)
  LOAN         // قرض / سلفة
  EXTERNAL     // حساب خارجي (متابعة فقط - زي عقار، حساب شخص تاني)
}

enum Currency {
  EGP
  SAR
  USD
  EUR
  AED
}

// ===== Category (الفئات: مصروفات + دخل) =====
model Category {
  id        String        @id @default(cuid())
  nameAr    String
  nameEn    String
  type      CategoryType
  icon      String        @default("tag")
  color     String        @default("#10B981")
  isDefault Boolean       @default(false)
  userId    String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets     Budget[]

  @@map("categories")
}

enum CategoryType {
  EXPENSE
  INCOME
  TRANSFER   // تحويل بين حسابين (لا يحسب كدخل أو مصروف)
}

// ===== Transaction (المعاملة: مصروف أو دخل أو تحويل) =====
model Transaction {
  id            String   @id @default(cuid())
  type          CategoryType
  amount        Float
  currency      Currency
  accountId     String
  categoryId    String
  toAccountId   String?
  date          DateTime  @default(now())
  note          String?
  tags          String?
  transferPairId String?
  userId        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  toAccount    Account?  @relation("TransfersTo", fields: [toAccountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([accountId])
  @@index([toAccountId])
  @@index([categoryId])
  @@index([date])
  @@index([type])
  @@index([userId])
  @@map("transactions")
}

// ===== Budget (الميزانية الشهرية لكل فئة) =====
model Budget {
  id          String   @id @default(cuid())
  categoryId  String
  month       String
  limit       Float
  currency    Currency   @default(EGP)
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, month])
  @@index([month])
  @@index([userId])
  @@map("budgets")
}

// ===== Setting (DELETED — was global singleton with no userId, security risk) =====
// Previously: model Setting { id, key, value } — no userId, accessible to all users.
// Removed in P0.11 because:
//   (1) the /api/settings route had no auth (anyone could read/write global config)
//   (2) the frontend never used it (settings stored in zustand/localStorage)
// If per-user server-side settings are needed in the future, add a `userId` field.

