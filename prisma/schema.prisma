// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===== Account (الحسابات: كاش/بنك/محفظة إلكترونية) =====
model Account {
  id        String   @id @default(cuid())
  name      String                       // اسم الحساب (مثال: محفظتي البنكية)
  type      AccountType                  // نوع الحساب
  currency  Currency                     // عملة الحساب
  balance   Float    @default(0)          // الرصيد الافتراضي
  color     String   @default("#2563EB") // لون الحساب
  icon      String   @default("wallet")  // أيقونة
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions      Transaction[]
  transfersTo       Transaction[] @relation("TransfersTo")

  @@map("accounts")
}

enum AccountType {
  CASH         // نقدي
  BANK         // بنك
  E_WALLET     // محفظة إلكترونية
  CARD         // بطاقة ائتمان
  SAVINGS      // حساب توفير
  INVESTMENT   // استثمار (ذهب، كريبتو، أسهم، صناديق)
  LOAN         // قرض / سلفة
  EXTERNAL     // حساب خارجي (متابعة فقط - زي عقار، حساب شخص تاني)
}

enum Currency {
  EGP
  SAR
  USD
  EUR
  AED
}

// ===== Category (الفئات: مصروفات + دخل) =====
model Category {
  id        String        @id @default(cuid())
  nameAr    String                     // الاسم بالعربي
  nameEn    String                     // الاسم بالإنجليزي
  type      CategoryType               // EXPENSE or INCOME
  icon      String        @default("tag") // اسم الأيقونة (lucide)
  color     String        @default("#10B981")
  isDefault Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  transactions Transaction[]
  budgets     Budget[]

  @@map("categories")
}

enum CategoryType {
  EXPENSE
  INCOME
  TRANSFER   // تحويل بين حسابين (لا يحسب كدخل أو مصروف)
}

// ===== Transaction (المعاملة: مصروف أو دخل أو تحويل) =====
model Transaction {
  id            String   @id @default(cuid())
  type          CategoryType                // EXPENSE | INCOME | TRANSFER
  amount        Float                       // المبلغ بعملة المعاملة
  currency      Currency                    // عملة المعاملة
  accountId     String                      // الحساب المصدر (للتحويل: الحساب اللي بيتسحب منه)
  categoryId    String                      // الفئة (للتحويل: فئة 'تحويلات')
  toAccountId   String?                     // للتحويل فقط: الحساب الوجهة
  date          DateTime  @default(now())  // تاريخ المعاملة
  note          String?                     // ملاحظة
  tags          String?                     // علامات تصنيف
  transferPairId String?                    // ID للمعاملة المزدوجة في التحويل (الوجهة)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  toAccount     Account? @relation("TransfersTo", fields: [toAccountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([accountId])
  @@index([toAccountId])
  @@index([categoryId])
  @@index([date])
  @@index([type])
  @@map("transactions")
}

// ===== Budget (الميزانية الشهرية لكل فئة) =====
model Budget {
  id          String   @id @default(cuid())
  categoryId  String                     // الفئة
  month       String                     // الشهر بصيغة YYYY-MM
  limit       Float                       // الحد الأقصى
  currency    Currency   @default(EGP)   // العملة
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, month])
  @@index([month])
  @@map("budgets")
}

// ===== Setting (الإعدادات العامة) =====
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ===== RecurringTransaction (معاملات متكررة - #1) =====
model RecurringTransaction {
  id          String   @id @default(cuid())
  type        String   // EXPENSE | INCOME | TRANSFER
  amount      Float
  currency    String
  accountId   String
  categoryId  String
  toAccountId String?  // للتحويلات
  frequency   String   // daily | weekly | monthly | yearly
  dayOfMonth  Int?     // يوم التنفيذ (1-31)
  startDate   DateTime
  endDate     DateTime?
  lastRun     DateTime?
  nextRun     DateTime
  note        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("recurring_transactions")
}

// ===== SavingsGoal (أهداف ادخارية - #7) =====
model SavingsGoal {
  id          String   @id @default(cuid())
  name        String
  targetAmount Float
  currentAmount Float @default(0)
  currency    String   @default("EGP")
  targetDate  DateTime?
  color       String   @default("#10B981")
  icon        String   @default("piggy-bank")
  achieved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("savings_goals")
}

// ===== BillReminder (تذكير فواتير - #8) =====
model BillReminder {
  id          String   @id @default(cuid())
  name        String
  amount      Float
  currency    String   @default("EGP")
  dueDate     DateTime
  recurring   Boolean  @default(true)
  frequency   String   @default("monthly") // daily | weekly | monthly | yearly
  accountId   String?
  paid        Boolean  @default(false)
  remindDays  Int      @default(3) // تذكير قبل كام يوم
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("bill_reminders")
}
